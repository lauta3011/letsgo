---
interface Props {
  className?: string;
  direction?: "up" | "left" | "right" | "down";
  delay?: number;
}

const { className = "", direction = "up", delay = 0 } = Astro.props;
const slideClass = `slide-in slide-in--${direction}`;
---

<div class={`${slideClass} ${className}`} data-slide-in style={delay ? `transition-delay:${delay}ms` : undefined}>
  <slot />
</div>

<style>
  .slide-in {
    margin: 0px 28px;
    opacity: 0;
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .slide-in.is-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  .slide-in--up {
    transform: translateY(3rem);
  }

  .slide-in--down {
    transform: translateY(-3rem);
  }

  .slide-in--left {
    transform: translateX(-3rem);
  }

  .slide-in--right {
    transform: translateX(3rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  const els = document.querySelectorAll("[data-slide-in]");
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 }
  );
  els.forEach((el) => io.observe(el));
</script>
