---
const logos = ["oktana", "habitue", "mosca", "globant"];
---

<section class="w-screen text-swiss-lime">
  <div class="border-y border-swiss-plum">
    <h2 class="border-b border-swiss-plum px-6 py-4 text-xs uppercase tracking-widest">
      Worked on these companies
    </h2>
    <div class="grid grid-cols-2 divide-x divide-y divide-swiss-plum sm:grid-cols-4">
      {
        logos.map((logo) => (
          <div class="flex items-center justify-center px-6 py-10">
            <img
              src={`logos/${logo}-logo.png`}
              alt={`${logo} logo`}
              class="w-32 grayscale invert opacity-80 sm:w-40"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
