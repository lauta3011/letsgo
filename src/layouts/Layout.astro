---
import Figures from "../components/figures/figures.astro";

export interface Props {
  title: string;
  metaDescription?: string;
}

const { title, metaDescription } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Michroma&display=swap"
    />
  </head>
  <body class="overflow-x-hidden" style="background-color:var(--swiss-meeple)">
    <Figures />
    <div class="page-content">
      <slot />
    </div>
  </body>
</html>
<style is:global>
  :root {
    --swiss-meeple: #1c0118;
    --swiss-lime: #6bd425;
    --swiss-plum: #370926;
    --swiss-olive: #618b25;
    --font-swiss: "Michroma", sans-serif;
  }

  html,
  body {
    font-family: var(--font-swiss);
  }

  .page-content {
    position: relative;
    z-index: 1;
  }
</style>
